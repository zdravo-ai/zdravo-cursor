{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-07-09/server.schema.json",
  "name": "zdravo-cursor",
  "description": "Cursor plugin wrapper that proxies to the @zdravoai/mcp server.",
  "version": "2.2.3",
  "repository": {
    "url": "https://github.com/zdravoai/zdravo-mcp.git",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "zdravo-mcp",
      "version": "2.2.3",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "ZDRAVO_API_KEY",
          "description": "Your Zdravo AI API key from https://zdravo.ai/dashboard/mcp",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
